{
  "name": "@monorepo/lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsgo --build && storybook build",
    "clean": "tsgo --build --clean",
    "dev": "storybook dev --no-open --port 6009",
    "preview": "vite preview --outDir storybook-static",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:update": "vitest run --update",
    "test:watch": "vitest --watch",
    "typecheck": "tsgo --build"
  },
  "dependencies": {
    "@dicebear/core": "catalog:",
    "@dicebear/styles": "catalog:",
    "@faker-js/faker": "catalog:",
    "@monorepo/storybook-addons": "workspace:^",
    "@monorepo/tailwindcss": "workspace:^",
    "@monorepo/utils": "workspace:^",
    "@radix-ui/react-label": "catalog:",
    "@radix-ui/react-slider": "catalog:",
    "@react-hookz/web": "catalog:",
    "es-toolkit": "catalog:",
    "figma-squircle": "catalog:",
    "lenis": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "nanoid": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-scan": "catalog:",
    "react-usestateref": "catalog:",
    "sonner": "catalog:",
    "tweakpane": "catalog:",
    "usehooks-ts": "catalog:",
    "vaul": "catalog:"
  },
  "devDependencies": {
    "@monorepo/tsconfig": "workspace:^",
    "@storybook/addon-docs": "catalog:",
    "@storybook/builder-vite": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tweakpane/core": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "csstype": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
