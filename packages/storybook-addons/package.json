{
  "name": "@monorepo/storybook-addons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./background": {
      "development": "./src/background/index.ts",
      "import": "./dist/background/index.js",
      "default": null
    },
    "./theme": {
      "development": "./src/theme/index.ts",
      "import": "./dist/theme/index.js",
      "default": null
    }
  },
  "scripts": {
    "build": "tsgo --build",
    "clean": "tsgo --build --clean",
    "dev": "tsgo --build --watch"
  },
  "devDependencies": {
    "@monorepo/tsconfig": "workspace:^",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native-preview": "catalog:",
    "react": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@storybook/react-vite": "catalog:",
    "react": "catalog:"
  }
}
