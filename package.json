{
  "name": "interaction-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --max-warnings=0",
    "lint:type-aware": "oxlint --type-aware --max-warnings=0",
    "prepare": "husky",
    "smoke:stories": "node scripts/smoke-stories.mjs",
    "sort-package-json:check": "sort-package-json '**/package.json' --ignore '**/node_modules/' --ignore '**/dist/' --ignore '**/dist-*/' --check",
    "sort-package-json:sort": "sort-package-json '**/package.json' --ignore '**/node_modules/' --ignore '**/dist/' --ignore '**/dist-*/'",
    "test:packages": "pnpm --filter '*' --workspace-concurrency=-2 run test",
    "test:update:packages": "pnpm --filter '*' --workspace-concurrency=-2 run test:update",
    "tsc:build:packages": "pnpm --filter '*' --workspace-concurrency=-2 run tsc:build",
    "tsc:build:root": "tsgo --build tsconfig.json"
  },
  "devDependencies": {
    "@mdx-js/language-service": "catalog:",
    "@monorepo/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "sort-package-json": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": "26.6.0",
    "pnpm": "*"
  }
}
